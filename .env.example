# Claude (understanding images, briefs and sites). Without it the app runs on stand-in answers.
ANTHROPIC_API_KEY=
# Optional: which Claude model to use
CLAUDE_MODEL=claude-sonnet-5-5

# Supabase (database + image storage). Without these the app saves to a local folder (fine on your computer, not on Vercel).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Image and product search (used from build step 2)
SERPAPI_API_KEY=

# A passcode that keeps the studio's projects private. Leave empty only for local testing.
STUDIO_PASSCODE=
